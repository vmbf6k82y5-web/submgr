{
  "name": "@submgr/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "订阅管家核心领域逻辑（纯函数，无任何 Cloudflare / 运行时依赖，前后端共用）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
